{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kssou-photosearch",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "kv_namespaces": [
    {
      "binding": "QUESTION_BANK",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
